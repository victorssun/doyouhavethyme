---
import '../styles/home.css';
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#f6f2e8" />
		<meta name="description" content="Click the box and drop in some thyme." />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<title>DoYouHaveThyme?</title>
	</head>
	<body>
		<main class="site-shell">
			<header>
				<nav aria-label="Site navigation"><a class="docs-link" href="/docs/">Docs</a></nav>
				<h1>DoYouHave<span>Thyme</span>?</h1>
			</header>

			<div class="world" id="world">
				<div class="box-shadow" aria-hidden="true"></div>
				<button class="box-button" id="box-button" type="button" aria-label="Drop a thyme sprig into the box">
					<svg class="box-back" viewBox="0 0 64 48" shape-rendering="crispEdges" aria-hidden="true">
						<rect x="11" y="11" width="43" height="16" fill="#5b402d" />
						<rect x="13" y="13" width="39" height="5" fill="#bd8953" />
						<rect x="13" y="18" width="39" height="9" fill="#483324" />
					</svg>
					<span class="falling-layer" id="falling-layer" aria-hidden="true"></span>
					<span class="box-fill" id="box-fill" aria-hidden="true"></span>
					<svg class="box-front" viewBox="0 0 64 48" shape-rendering="crispEdges" aria-hidden="true">
						<rect x="6" y="23" width="10" height="5" fill="#ae7745" />
						<rect x="50" y="22" width="9" height="6" fill="#ae7745" />
						<rect x="8" y="26" width="48" height="20" fill="#5b402d" />
						<rect x="10" y="29" width="44" height="15" fill="#ca955b" />
						<rect x="10" y="29" width="4" height="15" fill="#b6814d" />
						<rect x="31" y="30" width="2" height="13" fill="#ba834d" />
						<rect x="8" y="26" width="48" height="3" fill="#dda96d" />
						<rect x="19" y="36" width="2" height="1" fill="#b6814d" />
						<rect x="45" y="38" width="1" height="2" fill="#b6814d" />
					</svg>
				</button>
			</div>
		</main>

		<template id="sprig-template">
			<svg class="sprig-art" viewBox="0 0 16 24" shape-rendering="crispEdges" aria-hidden="true">
				<rect x="7" y="3" width="2" height="20" fill="#365c3b" />
				<rect x="6" y="1" width="4" height="4" fill="#83af64" />
				<rect x="3" y="5" width="4" height="3" fill="#5e954d" />
				<rect x="1" y="7" width="5" height="3" fill="#83af64" />
				<rect x="9" y="8" width="4" height="3" fill="#5e954d" />
				<rect x="10" y="10" width="5" height="3" fill="#83af64" />
				<rect x="3" y="13" width="4" height="3" fill="#5e954d" />
				<rect x="1" y="15" width="5" height="3" fill="#83af64" />
				<rect x="9" y="16" width="4" height="3" fill="#5e954d" />
				<rect x="10" y="18" width="5" height="3" fill="#83af64" />
			</svg>
		</template>
		<script src="../scripts/thyme.js"></script>
	</body>
</html>
